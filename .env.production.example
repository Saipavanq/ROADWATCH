# Copy this file to .env.production and set real values before deployment.

# Database
DB_NAME=roadwatch
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=******db:5432/roadwatch

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Public app URLs for CORS
CLIENT_URL=https://roadwatch.example.com
CLIENT_URLS=https://roadwatch.example.com,https://authority.roadwatch.example.com

# Frontend build-time API/socket settings
# Keep /api if backend is behind the frontend nginx proxy.
FRONTEND_VITE_API_URL=/api
AUTHORITY_VITE_API_URL=/api

# Optional: override for direct backend domain usage
# FRONTEND_VITE_SOCKET_URL=https://api.roadwatch.example.com
# AUTHORITY_VITE_SOCKET_URL=https://api.roadwatch.example.com
